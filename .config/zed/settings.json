// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
    "code_lens": "off",
    "toolbar": {
        "quick_actions": false,
        "breadcrumbs": false,
        "selections_menu": true,
        "agent_review": false
    },
    "reduce_motion": "on",
    "lsp_document_colors": "inlay",
    "middle_click_paste": false,
    "vim": {
        "use_smartcase_find": true,
        "toggle_relative_line_numbers": true
    },
    "show_wrap_guides": true,
    "semantic_tokens": "combined",
    "global_lsp_settings": {
      "semantic_token_rules": [
        { "token_type": "todoKeyword",       "foreground_color": "#FF8C00", "background_color": "#2B1700", "font_weight": "bold" },
        { "token_type": "fixmeKeyword",      "foreground_color": "#FF2D55", "background_color": "#2B0011", "font_weight": "bold" },
        { "token_type": "hackKeyword",       "foreground_color": "#FFD60A", "background_color": "#272100", "font_weight": "bold" },
        { "token_type": "noteKeyword",       "foreground_color": "#0A84FF", "background_color": "#001B2B", "font_weight": "bold" },
        { "token_type": "infoKeyword",       "foreground_color": "#0A84FF", "background_color": "#001B2B", "font_weight": "bold" },
        { "token_type": "warnKeyword",       "foreground_color": "#FF9F0A", "background_color": "#271B00", "font_weight": "bold" },
        { "token_type": "warningKeyword",    "foreground_color": "#FF9F0A", "background_color": "#271B00", "font_weight": "bold" },
        { "token_type": "bugKeyword",        "foreground_color": "#FF453A", "background_color": "#2B0A00", "font_weight": "bold" },
        { "token_type": "xxxKeyword",        "foreground_color": "#BF5AF2", "background_color": "#1B0029", "font_weight": "bold" },
        { "token_type": "deprecatedKeyword", "foreground_color": "#98989D", "background_color": "#1A1A1A", "font_weight": "bold" }
      ]
    },
    "calls": {
        "share_on_join": true,
        "mute_on_join": true
    },
    "vim_mode": false,
    "cli_default_open_behavior": "existing_window",
    "bottom_dock_layout": "contained",
    "tabs": {
        "show_diagnostics": "all",
        "file_icons": false,
        "git_status": false
    },
    "tab_bar": {
        "show_pinned_tabs_in_separate_row": false,
        "show_nav_history_buttons": true,
        "show": true
    },
    "debugger": {
        "dock": "right",
        "button": true
    },
    "search": {
        "button": false
    },
    "diagnostics": {
        "inline": {
            "enabled": true
        },
        "button": true
    },
    "terminal": {
        "button": true
    },
    "status_bar": {
        "show_active_file": false,
        "cursor_position_button": true,
        "active_language_button": true
    },
    "ui_font_weight": 100.0,
    "ui_font_family": "Maple Mono",
    "buffer_line_height": "standard",
    "outline_panel": {
        "dock": "left",
    },
    "collaboration_panel": {
        "button": false,
        "dock": "left",
    },
    "git_panel": {
        "tree_view": true,
        "dock": "left",
    },
    "inlay_hints": {
        "show_type_hints": true,
        "show_background": false,
        "show_value_hints": true,
        "enabled": false,
    },
    "languages": {
        "GDScript": {
            "formatter": {
                "external": {
                    "command": "gdscript-formatter",
                    "arguments": ["--reorder-code"],
                },
            },
        },
        "Rust": {
            "inlay_hints": {
                "enabled": true,
            },
        },
        "comment": {
            "indent_guides": {
                "background_coloring": "disabled",
            },
        },
        "Lua": {
            "tab_size": 2,
            "prettier": {
                "allowed": false,
            },
        },
        "Luau": {
            "tab_size": 2
        }
    },
    "tab_size": 4,
    "project_panel": {
        "diagnostic_badges": false,
        "button": true,
        "dock": "left",
    },
    "icon_theme": "Catppuccin Latte",
    "session": {
        "trust_all_worktrees": true,
    },
    "auto_update": false,
    "telemetry": {
        "diagnostics": false,
        "metrics": false,
    },
    "disable_ai": true,
    "buffer_font_weight": 300.0,
    "buffer_font_family": "Maple Mono",
    "format_on_save": "off",
    "ui_font_size": 15.0,
    "buffer_font_size": 14.0,
    "theme": {
        "mode": "dark",
        "light": "Catppuccin Iced Latte (Blur) [Heavy]",
        "dark": "Catppuccin Espresso (Blur) [Light]",
    },
    "title_bar": {
        // Whether to show onboarding banners in the titlebar.
        "button_layout": "platform_default",
        "show_menus": false,
        "show_user_menu": true,
        "show_project_items": true,
        "show_branch_name": true,
        "show_branch_status_icon": false,
        "show_onboarding_banner": false,
        // Whether to show user picture in the titlebar.
        "show_user_picture": true,
        // Whether to show the sign in button in the titlebar.
        "show_sign_in": true,
    },
}
